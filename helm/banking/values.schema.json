{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["images", "replicaCount"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 2},
    "images": {
      "type": "object", "required": ["account", "payment"],
      "additionalProperties": false,
      "properties": {
        "account": {"$ref": "#/definitions/image"},
        "payment": {"$ref": "#/definitions/image"}
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object", "required": ["repository", "digest"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/banking-dev-(account|payment)$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
