{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "eks-fargate-pods.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "866934333672"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:eks:us-east-2:866934333672:fargateprofile/banking-dev/*"
        }
      }
    }
  ]
}
