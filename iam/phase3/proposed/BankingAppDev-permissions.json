{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentityAndECRLogin",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BankingDevImageRelease",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-2:866934333672:repository/banking-dev-account",
        "arn:aws:ecr:us-east-2:866934333672:repository/banking-dev-payment"
      ]
    },
    {
      "Sid": "BankingDevClusterDiscovery",
      "Effect": "Allow",
      "Action": "eks:DescribeCluster",
      "Resource": "arn:aws:eks:us-east-2:866934333672:cluster/banking-dev"
    }
  ]
}
