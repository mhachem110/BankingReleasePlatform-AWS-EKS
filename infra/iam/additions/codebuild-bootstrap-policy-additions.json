{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageOnlyBankingEphemeralRunnerProject",
      "Effect": "Allow",
      "Action": [
        "codebuild:CreateProject",
        "codebuild:UpdateProject",
        "codebuild:DeleteProject",
        "codebuild:BatchGetProjects",
        "codebuild:CreateWebhook",
        "codebuild:UpdateWebhook",
        "codebuild:DeleteWebhook"
      ],
      "Resource": "arn:aws:codebuild:us-east-2:866934333672:project/banking-release-deployer"
    },
    {
      "Sid": "PassOnlyBankingEphemeralRunnerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-codebuild-runner",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "codebuild.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ApplyOnlyBankingEphemeralRunnerBoundary",
      "Effect": "Allow",
      "Action": "iam:PutRolePermissionsBoundary",
      "Resource": "arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-codebuild-runner",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::866934333672:policy/cloudbatch818-mahmoud-banking-codebuild-runner-boundary"
        }
      }
    },
    {
      "Sid": "PassOhioGitHubConnectionOnlyToCodeBuild",
      "Effect": "Allow",
      "Action": "codeconnections:PassConnection",
      "Resource": "arn:aws:codeconnections:us-east-2:866934333672:connection/*",
      "Condition": {
        "StringEquals": {"codeconnections:PassedToService": "codebuild.amazonaws.com"}
      }
    }
  ]
}
