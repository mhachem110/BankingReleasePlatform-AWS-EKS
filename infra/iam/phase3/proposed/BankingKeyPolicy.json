{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnableAccountIAMDelegation",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::866934333672:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "BankingLogsOnly",
      "Effect": "Allow",
      "Principal": {
        "Service": "logs.us-east-2.amazonaws.com"
      },
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:ReEncrypt*",
        "kms:GenerateDataKey*",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "kms:EncryptionContext:aws:logs:arn": [
            "arn:aws:logs:us-east-2:866934333672:log-group:/aws/eks/banking-dev/cluster",
            "arn:aws:logs:us-east-2:866934333672:log-group:/banking/banking-dev/vpc-flow"
          ]
        }
      }
    }
  ]
}
