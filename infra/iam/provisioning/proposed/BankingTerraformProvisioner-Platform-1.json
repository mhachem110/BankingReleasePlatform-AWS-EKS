{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketPolicy",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketTagging",
        "s3:GetLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::mhachem-banking-tfstate-866934333672"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::mhachem-banking-tfstate-866934333672",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "banking-release-platform/dev/platform/terraform.tfstate",
            "banking-release-platform/dev/platform/terraform.tfstate.tflock",
            "banking-release-platform/_workspaces/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::mhachem-banking-tfstate-866934333672/banking-release-platform/dev/platform/terraform.tfstate"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::mhachem-banking-tfstate-866934333672/banking-release-platform/dev/platform/terraform.tfstate.tflock"
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::mhachem-banking-tfstate-866934333672/banking-release-platform/shared/iam-prerequisites/terraform.tfstate"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeSubnets",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeAddresses",
        "ec2:DescribeNatGateways",
        "ec2:DescribeRouteTables",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeFlowLogs",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeTags",
        "eks:ListClusters",
        "eks:DescribeClusterVersions",
        "eks:DescribeAddonVersions",
        "eks:DescribeAddonConfiguration"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags"
      ],
      "Resource": [
        "arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-eks-cluster",
        "arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-fargate-execution",
        "arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-flow-logs",
        "arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-cloudops-bootstrap",
        "arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-cloudops-deploy-dev",
        "arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-cloudops-deploy-prod",
        "arn:aws:iam::866934333672:role/__APPROVED_OPERATOR_ROLE__",
        "arn:aws:iam::866934333672:role/aws-service-role/eks.amazonaws.com/AWSServiceRoleForAmazonEKS",
        "arn:aws:iam::866934333672:role/aws-service-role/eks-fargate.amazonaws.com/AWSServiceRoleForAmazonEKSForFargate"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::866934333672:policy/cloudbatch818-mahmoud-banking-service-boundary",
        "arn:aws:iam::866934333672:policy/BankingTerraformProvisioner-Platform-*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateVpc",
      "Resource": "arn:aws:ec2:us-east-2:866934333672:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "aws:RequestTag/Project": "BankingReleasePlatform",
          "aws:RequestTag/Environment": "dev"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateSubnet",
      "Resource": "arn:aws:ec2:us-east-2:866934333672:subnet/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "aws:RequestTag/Project": "BankingReleasePlatform",
          "aws:RequestTag/Environment": "dev"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateInternetGateway",
      "Resource": "arn:aws:ec2:us-east-2:866934333672:internet-gateway/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "aws:RequestTag/Project": "BankingReleasePlatform",
          "aws:RequestTag/Environment": "dev"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:AllocateAddress",
      "Resource": "arn:aws:ec2:us-east-2:866934333672:elastic-ip/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "aws:RequestTag/Project": "BankingReleasePlatform",
          "aws:RequestTag/Environment": "dev"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateNatGateway",
      "Resource": "arn:aws:ec2:us-east-2:866934333672:natgateway/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "aws:RequestTag/Project": "BankingReleasePlatform",
          "aws:RequestTag/Environment": "dev"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateRouteTable",
      "Resource": "arn:aws:ec2:us-east-2:866934333672:route-table/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "aws:RequestTag/Project": "BankingReleasePlatform",
          "aws:RequestTag/Environment": "dev"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateVpcEndpoint",
      "Resource": "arn:aws:ec2:us-east-2:866934333672:vpc-endpoint/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "aws:RequestTag/Project": "BankingReleasePlatform",
          "aws:RequestTag/Environment": "dev"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-east-2:866934333672:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "aws:RequestTag/Project": "BankingReleasePlatform",
          "aws:RequestTag/Environment": "dev"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateSubnet",
      "Resource": [
        "arn:aws:ec2:us-east-2:866934333672:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "aws:ResourceTag/Project": "BankingReleasePlatform",
          "aws:ResourceTag/Environment": "dev"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateRouteTable",
      "Resource": [
        "arn:aws:ec2:us-east-2:866934333672:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "aws:ResourceTag/Project": "BankingReleasePlatform",
          "aws:ResourceTag/Environment": "dev"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateNatGateway",
      "Resource": [
        "arn:aws:ec2:us-east-2:866934333672:subnet/*",
        "arn:aws:ec2:us-east-2:866934333672:elastic-ip/*",
        "arn:aws:ec2:us-east-2:866934333672:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "aws:ResourceTag/Project": "BankingReleasePlatform",
          "aws:ResourceTag/Environment": "dev"
        }
      }
    }
  ]
}
