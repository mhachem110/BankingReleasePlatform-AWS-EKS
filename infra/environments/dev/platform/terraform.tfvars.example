# Examples only; copy to an ignored .tfvars after administrator approval.
aws_region          = "us-east-2"
expected_account_id = "REPLACE_WITH_VERIFIED_ACCOUNT"
state_bucket_name   = "REPLACE_WITH_APPROVED_BANKING_BUCKET"
availability_zones  = ["us-east-2a", "us-east-2b"]
vpc_cidr            = "10.70.0.0/16"
endpoint_cidrs      = ["REPLACE_WITH_APPROVED_OPERATOR_OR_RUNNER_IPV4_CIDR"]
cluster_role_arn    = "REPLACE_WITH_ADMINISTRATOR_CLUSTER_ROLE_ARN"
fargate_execution_role_arn       = "REPLACE_WITH_ADMINISTRATOR_PATHLESS_FARGATE_EXECUTION_ROLE_ARN"
flow_log_role_arn   = "REPLACE_WITH_ADMINISTRATOR_FLOW_LOG_ROLE_ARN"
operator_role_arn   = "REPLACE_WITH_VERIFIED_EXISTING_OPERATOR_IAM_ROLE_ARN"
deployer_role_arn   = "REPLACE_WITH_VERIFIED_EXISTING_APPLICATION_DEPLOY_ROLE_ARN"
kms_key_arn         = "REPLACE_WITH_APPROVED_ENABLED_SYMMETRIC_KEY_ARN"
# Resolve compatibility through the reviewed read-only GitHub preflight, then
# paste exact versions here. Do not guess versions or use most_recent in Terraform.
addon_versions = {
  coredns                = "REPLACE_WITH_COMPATIBLE_VERSION"
  metrics-server         = "REPLACE_WITH_COMPATIBLE_VERSION"
}

owner = "MahmoudHachem"
# cost_center = "ACTUAL_APPROVED_VALUE" # optional; omit until assigned

# Full shared-role audit is required before approving reuse.
prod_deployer_role_arn = "arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-cloudops-deploy-prod"
