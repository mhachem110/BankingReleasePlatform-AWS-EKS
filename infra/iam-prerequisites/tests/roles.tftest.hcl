mock_provider "aws" {
  mock_data "aws_caller_identity" { defaults = { account_id = "866934333672" } }
}
override_data {
  target = data.aws_iam_policy.boundary
  values = { policy = "{\"Statement\":[{\"Action\":[\"ec2:DescribeInstances\",\"ec2:DescribeNetworkInterfaces\",\"ec2:DescribeVpcs\",\"ec2:DescribeDhcpOptions\",\"ec2:DescribeAvailabilityZones\",\"ec2:DescribeInstanceTopology\"],\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-eks-cluster\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":\"*\"},{\"Action\":\"ec2:CreateTags\",\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-eks-cluster\"},\"ForAllValues:StringEquals\":{\"aws:TagKeys\":[\"kubernetes.io/cluster/banking-dev\"]},\"Null\":{\"aws:TagKeys\":\"false\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":\"arn:aws:ec2:us-east-2:866934333672:instance/*\"},{\"Action\":\"kms:DescribeKey\",\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-eks-cluster\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":\"arn:aws:kms:us-east-2:866934333672:key/*\"},{\"Action\":\"ecr:GetAuthorizationToken\",\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-fargate-execution\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":\"*\"},{\"Action\":[\"ecr:BatchCheckLayerAvailability\",\"ecr:GetDownloadUrlForLayer\",\"ecr:BatchGetImage\"],\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-fargate-execution\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:ecr:us-east-2:866934333672:repository/banking-dev-account\",\"arn:aws:ecr:us-east-2:866934333672:repository/banking-dev-payment\",\"arn:aws:ecr:us-east-2:602401143452:repository/eks/*\"]},{\"Action\":[\"logs:CreateLogStream\",\"logs:PutLogEvents\",\"logs:DescribeLogStreams\"],\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-flow-logs\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":\"arn:aws:logs:us-east-2:866934333672:log-group:/banking/banking-dev/vpc-flow:*\"},{\"Action\":\"logs:DescribeLogGroups\",\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-flow-logs\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":\"*\"},{\"Action\":[\"iam:*\",\"sts:AssumeRole*\"],\"Effect\":\"Deny\",\"Resource\":\"*\"}],\"Version\":\"2012-10-17\"}" }
}
variables {
  permissions_boundary_arn = "arn:aws:iam::866934333672:policy/cloudbatch818-mahmoud-banking-service-boundary"
  boundary_policy_sha256   = sha256("{\"Statement\":[{\"Action\":[\"ec2:DescribeInstances\",\"ec2:DescribeNetworkInterfaces\",\"ec2:DescribeVpcs\",\"ec2:DescribeDhcpOptions\",\"ec2:DescribeAvailabilityZones\",\"ec2:DescribeInstanceTopology\"],\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-eks-cluster\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":\"*\"},{\"Action\":\"ec2:CreateTags\",\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-eks-cluster\"},\"ForAllValues:StringEquals\":{\"aws:TagKeys\":[\"kubernetes.io/cluster/banking-dev\"]},\"Null\":{\"aws:TagKeys\":\"false\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":\"arn:aws:ec2:us-east-2:866934333672:instance/*\"},{\"Action\":\"kms:DescribeKey\",\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-eks-cluster\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":\"arn:aws:kms:us-east-2:866934333672:key/*\"},{\"Action\":\"ecr:GetAuthorizationToken\",\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-fargate-execution\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":\"*\"},{\"Action\":[\"ecr:BatchCheckLayerAvailability\",\"ecr:GetDownloadUrlForLayer\",\"ecr:BatchGetImage\"],\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-fargate-execution\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:ecr:us-east-2:866934333672:repository/banking-dev-account\",\"arn:aws:ecr:us-east-2:866934333672:repository/banking-dev-payment\",\"arn:aws:ecr:us-east-2:602401143452:repository/eks/*\"]},{\"Action\":[\"logs:CreateLogStream\",\"logs:PutLogEvents\",\"logs:DescribeLogStreams\"],\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-flow-logs\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":\"arn:aws:logs:us-east-2:866934333672:log-group:/banking/banking-dev/vpc-flow:*\"},{\"Action\":\"logs:DescribeLogGroups\",\"Condition\":{\"ArnEquals\":{\"aws:PrincipalArn\":\"arn:aws:iam::866934333672:role/cloudbatch818-mahmoud-banking-flow-logs\"},\"StringEquals\":{\"aws:RequestedRegion\":\"us-east-2\"}},\"Effect\":\"Allow\",\"Resource\":\"*\"},{\"Action\":[\"iam:*\",\"sts:AssumeRole*\"],\"Effect\":\"Deny\",\"Resource\":\"*\"}],\"Version\":\"2012-10-17\"}")
}
run "three_service_roles_only" {
  command = plan
  assert {
    condition     = length(aws_iam_role.service) == 3 && alltrue([for r in aws_iam_role.service : r.permissions_boundary == var.permissions_boundary_arn && r.path == "/"])
    error_message = "Only the three bounded, pathless service roles are allowed."
  }
  assert {
    condition     = aws_iam_role_policy_attachment.cluster.policy_arn == "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy" && aws_iam_role_policy_attachment.fargate.policy_arn == "arn:aws:iam::aws:policy/AmazonEKSFargatePodExecutionRolePolicy" && aws_iam_role_policy.flow.name == "BankingFlowLogs"
    error_message = "Exact approved service permissions required."
  }
}
run "boundary_drift_rejected" {
  command = plan
  variables { boundary_policy_sha256 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
  expect_failures = [terraform_data.authorization]
}
run "other_boundary_rejected" {
  command = plan
  variables { permissions_boundary_arn = "arn:aws:iam::866934333672:policy/Unbounded" }
  expect_failures = [var.permissions_boundary_arn]
}
