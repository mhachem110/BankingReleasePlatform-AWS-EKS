{
  "title": "BankingReleasePlatform application operations",
  "uid": "banking-app-operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "utc",
  "tags": [
    "BankingReleasePlatform",
    "dev",
    "synthetic-data"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "banking-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job) (rate(banking_http_requests_total{route=~\"/api/.*\"}[5m]))",
          "legendFormat": "{{job}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 5xx per second",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "banking-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job) (rate(banking_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "{{job}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API p95 latency",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "banking-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,job) (rate(banking_http_request_duration_seconds_bucket{route=~\"/api/.*\"}[5m])))",
          "legendFormat": "{{job}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Process working set",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "banking-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "banking_process_working_set_bytes",
          "legendFormat": "{{job}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Process CPU cores used",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "banking-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(banking_process_cpu_seconds_total[5m])",
          "legendFormat": "{{job}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Storage readiness",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "banking-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by(job) (banking_storage_ready)",
          "legendFormat": "{{job}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbox pending and dead",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "banking-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(banking_outbox_pending)",
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "expr": "max(banking_outbox_dead)",
          "legendFormat": "dead"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Oldest pending event",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "banking-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(banking_outbox_oldest_seconds)",
          "legendFormat": "{{job}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Event delivery and retries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "banking-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(banking_events_published_total[5m]))",
          "legendFormat": "published"
        },
        {
          "refId": "B",
          "expr": "sum by(stage) (rate(banking_event_retries_total[5m]))",
          "legendFormat": "retry {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    }
  ],
  "editable": true
}
